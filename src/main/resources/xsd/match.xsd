<?xml version="1.0" encoding="UTF-8"?>

<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" 
           targetNamespace="http://wslfootballtracker.com" 
           xmlns:tns="http://wslfootballtracker.com" 
           elementFormDefault="qualified">

    <xs:element name="MatchRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="homeTeam" type="xs:string"/>
                <xs:element name="awayTeam" type="xs:string"/>
                <xs:element name="homeScore" type="xs:int"/>
                <xs:element name="awayScore" type="xs:int"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="MatchResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="message" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>